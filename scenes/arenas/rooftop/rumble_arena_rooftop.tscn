[gd_scene load_steps=9 format=3 uid="uid://b7x2wq4n8kv3m"]

; Reuses the back-alley arena's match-management script as-is — it has no
; back-alley-specific coupling (all node lookups are generic paths any
; correctly-structured arena scene provides: SpawnPoints/PlayerSpawn,
; HUD/HUDRoot/*, Camera3D), so this is a genuine "arena match manager",
; not a hardcoded one-off. Reusing it here avoids duplicating ~370 lines
; of round/combo/special-meter/pool wiring for a scene that's otherwise
; just different geometry and mood lighting.
[ext_resource type="Script" path="res://scenes/arenas/back_alley/rumble_arena_back_alley.gd" id="1"]
[ext_resource type="Environment" path="res://assets/environments/arena_rooftop.tres" id="3"]

[sub_resource type="PlaneMesh" id="PlaneMesh_floor"]
size = Vector2(16, 12)

[sub_resource type="StandardMaterial3D" id="Mat_floor"]
albedo_color = Color(0.08, 0.09, 0.11, 1)
roughness = 0.85
emission_enabled = true
emission = Color(0.15, 0.18, 0.3, 1)
emission_energy_multiplier = 0.4

[sub_resource type="BoxShape3D" id="BoxShape3D_floor"]
size = Vector3(16, 0.2, 12)

[sub_resource type="BoxShape3D" id="WallShapeZ"]
size = Vector3(16, 2.4, 0.3)

[sub_resource type="BoxShape3D" id="WallShapeX"]
size = Vector3(0.3, 2.4, 12)

[sub_resource type="BoxMesh" id="HvacMesh"]
size = Vector3(1.4, 1.0, 1.0)

[sub_resource type="StandardMaterial3D" id="Mat_hvac"]
albedo_color = Color(0.25, 0.25, 0.27, 1)
roughness = 0.7

[node name="RumbleArenaRooftop" type="Node3D"]
script = ExtResource("1")
waves = [{"team": 1, "count": 2}, {"team": 1, "count": 3}, {"team": 1, "count": 4}]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = ExtResource("3")

; Cool-toned "moonlight" — distinguishes the rooftop's night mood from the
; back alley's neutral daylight-ish key light.
[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866, -0.353, 0.354, 0, 0.707, 0.707, -0.5, -0.612, 0.612, 0, 8, 0)
light_color = Color(0.75, 0.8, 1.0, 1)
light_energy = 0.6
shadow_enabled = true

[node name="AmbientLight" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 4, 0)
light_color = Color(0.6, 0.7, 1.0, 1)
light_energy = 0.35
omni_range = 18.0

; arena_camera.gd is attached at runtime via set_script() in
; rumble_arena_back_alley.gd's _ready() (matches the back-alley arena
; exactly) — NOT attached here directly. set_script() on an already-in-tree
; node does not re-trigger _ready(), so a direct attachment here would risk
; arena_camera.gd's own _ready() (which sets _origin and _last_tick_usec)
; never running.
[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.766, 0.643, 0, -0.643, 0.766, 0, 6, 9)
current = true

[node name="Floor" type="StaticBody3D" parent="."]

[node name="FloorMesh" type="MeshInstance3D" parent="Floor"]
